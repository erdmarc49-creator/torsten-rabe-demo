<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Muster Kfz-Technik | Demo-Entwurf einer Werkstatt-Website</title>
<meta name="description" content="Unverbindlicher Demo-Entwurf einer Werkstatt-Website. Alle Angaben sind Platzhalter.">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#111315">
<style>
:root{
  --bg:#111315; --bg2:#191D20; --line:#262b2f;
  --accent:#FF6B24; --accent-d:#e55a14;
  --text:#F5F5F5; --muted:#A5A9AD;
  --radius:14px; --maxw:1160px;
  --font:"Segoe UI","Helvetica Neue",Arial,system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);line-height:1.65;overflow-x:hidden}
img,svg{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.wrap{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 24px}
.skip{position:absolute;left:-999px;top:8px;background:var(--accent);color:#111;padding:10px 16px;border-radius:8px;z-index:100;font-weight:700}
.skip:focus{left:8px}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}

/* Demo-Banner */
.demo-bar{background:var(--accent);color:#111315;font-size:.82rem;font-weight:700;text-align:center;padding:8px 16px;letter-spacing:.02em}

/* Header */
.site-header{position:sticky;top:0;z-index:50;background:rgba(17,19,21,.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid transparent;transition:border-color .3s,background .3s}
.site-header.scrolled{border-color:var(--line);background:rgba(17,19,21,.95)}
.nav{display:flex;align-items:center;justify-content:space-between;height:72px}
.logo{display:flex;flex-direction:column;line-height:1}
.logo b{font-size:1.2rem;letter-spacing:.16em;font-weight:800}
.logo span{font-size:.68rem;letter-spacing:.34em;color:var(--accent);margin-top:5px;font-weight:600}
.menu{display:flex;gap:6px;list-style:none;margin:0;padding:0;align-items:center}
.menu a{display:block;padding:10px 14px;font-size:.95rem;color:var(--muted);border-radius:8px;transition:color .25s}
.menu a:hover,.menu a[aria-current="true"]{color:var(--text)}
.menu .cta{background:var(--accent);color:#111315;font-weight:700;margin-left:8px;transition:background .25s,transform .25s}
.menu .cta:hover{background:var(--accent-d);color:#111315;transform:translateY(-1px)}
.burger{display:none;width:48px;height:48px;background:none;border:1px solid var(--line);border-radius:10px;cursor:pointer;color:var(--text);position:relative}
.burger span,.burger span::before,.burger span::after{position:absolute;left:13px;width:20px;height:2px;background:currentColor;border-radius:2px;transition:transform .3s,opacity .3s,top .3s}
.burger span{top:22px}.burger span::before{content:"";top:-7px;left:0}.burger span::after{content:"";top:7px;left:0}
.burger[aria-expanded="true"] span{background:transparent}
.burger[aria-expanded="true"] span::before{top:0;transform:rotate(45deg)}
.burger[aria-expanded="true"] span::after{top:0;transform:rotate(-45deg)}

/* Hero */
.hero{position:relative;min-height:calc(100svh - 110px);display:flex;align-items:center;isolation:isolate;overflow:hidden}
.hero-art{position:absolute;inset:0;z-index:-2}
.hero-art svg{width:100%;height:100%;object-fit:cover}
.hero::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(17,19,21,.96) 0%,rgba(17,19,21,.82) 48%,rgba(17,19,21,.45) 100%),linear-gradient(0deg,var(--bg) 0%,transparent 28%)}
.hero-inner{padding:72px 0 96px;max-width:720px}
.eyebrow{display:inline-flex;align-items:center;gap:12px;font-size:.78rem;font-weight:700;letter-spacing:.26em;color:var(--accent);text-transform:uppercase}
.eyebrow::before{content:"";width:36px;height:2px;background:var(--accent)}
h1{font-size:clamp(2.4rem,7vw,4.7rem);line-height:1.04;margin:20px 0 22px;letter-spacing:-.02em;font-weight:800}
.lead{font-size:clamp(1.02rem,2.2vw,1.2rem);color:var(--muted);max-width:560px;margin:0 0 36px}
.btns{display:flex;flex-wrap:wrap;gap:14px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 28px;border-radius:12px;font-weight:700;font-size:1rem;border:1.5px solid transparent;cursor:pointer;transition:transform .25s,background .25s,border-color .25s,box-shadow .25s}
.btn svg{width:18px;height:18px;transition:transform .25s}
.btn-primary{background:var(--accent);color:#111315}
.btn-primary:hover{background:var(--accent-d);transform:translateY(-2px);box-shadow:0 10px 28px -10px rgba(255,107,36,.7)}
.btn-primary:hover svg{transform:translateX(3px)}
.btn-ghost{border-color:#3a4046;color:var(--text)}
.btn-ghost:hover{border-color:var(--accent);transform:translateY(-2px)}

/* Sections */
section{padding:104px 0}
.sec-head{max-width:640px;margin-bottom:56px}
h2{font-size:clamp(1.8rem,4.4vw,2.9rem);line-height:1.12;margin:16px 0 0;letter-spacing:-.015em;font-weight:800}
.sec-head p{color:var(--muted);margin:18px 0 0}

/* Leistungen */
#leistungen{background:var(--bg2)}
.notice{display:flex;gap:12px;align-items:flex-start;border:1px dashed #4a4f55;border-radius:12px;padding:14px 18px;font-size:.9rem;color:var(--muted);margin:0 0 40px;max-width:760px}
.notice svg{width:20px;height:20px;flex:none;color:var(--accent);margin-top:2px}
